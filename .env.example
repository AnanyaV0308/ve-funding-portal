# Copy to .env at the repo root. Both the web app and the worker read it.

# Local Postgres from docker-compose. In staging/production this is the Supabase connection string.
DATABASE_URL=postgres://ve:ve@localhost:5432/ve_funding

# Auth.js. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000

# Microsoft Entra ID (Microsoft 365 sign-in). Leave blank until VE's admin registers the app.
# Issuer is https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Local-only "sign in as a demo user" button. Never enabled when NODE_ENV=production.
AUTH_DEV_LOGIN=true

# Comma-separated emails that get the admin role on first sign-in.
ADMIN_EMAILS=ananya@example.org

# Where uploaded files are stored in local development (defaults to apps/web/.data/uploads).
# The worker reads imports from here too, so use an absolute path if you set it.
# Production uses Supabase Storage, which is added when the Supabase project exists.
# FILE_STORAGE_DIR=
