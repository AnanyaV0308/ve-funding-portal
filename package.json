{
  "name": "ve-funding-portal",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "worker": "pnpm --filter worker dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:generate": "pnpm --filter @ve/db generate",
    "db:migrate": "pnpm --filter @ve/db migrate",
    "db:seed": "pnpm --filter @ve/db seed"
  }
}
